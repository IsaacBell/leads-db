{
  "name": "leads-db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "pnpm dlx eslint .",
    "lint:fix": "pnpm lint -- --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci:ioc": "just ci-ioc",
    "ci:silver-gate": "just ci-silver-gate",
    "ci:whitespace": "just ci-whitespace",
    "ci:security": "just ci-security",
    "precommit": "just pre-commit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm dlx lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm dlx tsc --noEmit",
      "pnpm lint:fix",
      "pnpm dlx prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@kinde-oss/kinde-auth-react": "^5.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "20.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/otel": "^2.1.3",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "schema-dts": "^2.0.0",
    "typescript": "5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5"
    }
  }
}
